@using Models;
@model ClientFormViewModel
@{
    ViewData["Title"] = "ClientForm";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}
<link href="~/stylesheet/clientform.css" rel="stylesheet" />
@{
    string cliendId = Context.Session.GetString("clientId");
    bool isClient = cliendId != null ? true : false;
}
<div class="page-container">
    <form asp-controller=@(!isClient ? "Guest" : "Client") asp-action=@(!isClient ? "Registration" : "UpdateProfile")
          class="Signup" method="post">
        <h1 class="Title">@(isClient ? "Update Your Profile" : "SignUp")</h1>
        <ul class="fields">
            <li class="field">
                <div class="input-wrapper">
                    @if (!isClient)
                    {
                        <!-- במצב הרשמה: השדה פתוח להקלדה -->
                        <input asp-for="Client.ClientId" id="id" type="text" placeholder="ID" />
                    }
                    else
                    {
                        <!-- במצב עדכון פרופיל: השדה חסום לעריכה כי תעודת זהות לא משתנה -->
                        <input asp-for="Client.ClientId" id="id" type="text" placeholder="ID" readonly style="pointer-events: none; cursor: not-allowed;"/>
                    }
                    <img class="icon" src="~/images/@(!isClient ? "id.png" : "disabled.png")" />
                </div>
                <span asp-validation-for="Client.ClientId" class="errorData"></span>
            </li>
            <li class="double-field">
                <div class="field">
                    <div class="input-wrapper">
                        <input asp-for="Client.ClientName" id="firstname" type="text" placeholder="First Name" />
                        <img class="icon" src="~/images/@(!isClient ? "profile.png" : "edit.png")" />
                    </div>
                    <span asp-validation-for="Client.ClientName" class="errorData"></span>
                </div>

                <div class="field">
                    <div class="input-wrapper">
                        <input asp-for="Client.ClientLastName" id="lastname" type="text" placeholder="Last Name" />
                        <img class="icon" src="~/images/@(!isClient ? "profile.png" : "edit.png")" />
                    </div>
                    <span asp-validation-for="Client.ClientLastName" class="errorData"></span>
                </div>
            </li>
            <li class="field">
                <div class="input-wrapper">
                    <input asp-for="Client.ClientPhoneNumber" id="phonenumber" type="text" placeholder="Phone Number" />
                    <img class="icon" src="~/images/@(!isClient ? "phone.png" : "edit.png")" />
                </div>
                <span asp-validation-for="Client.ClientPhoneNumber" class="errorData"></span>
            </li>
            <li class="field">
                <select asp-for="Client.CityId" id="city">
                    <option value="0">Select City</option>
                    @foreach (City city in Model.Cities)
                    {
                        <option value="@city.CityId">@city.CityName</option>
                    }
                </select>
                <span asp-validation-for="Client.CityId" class="errorData"></span>
            </li>
            <li class="field">
                <div class="input-wrapper">
                    <input asp-for="Client.ClientAddress" id="Address" type="text" placeholder="Address" />
                    <img class="icon" src="~/images/@(!isClient ? "address.png" : "edit.png")" />
                </div>
                <span asp-validation-for="Client.ClientAddress" class="errorData"></span>
            </li>
            <li class="field">
                <div class="input-wrapper">
                    <input asp-for="Client.ClientEmail" id="email" type="text" placeholder="Email" />
                    <img class="icon" src="~/images/@(!isClient ? "email.png" : "edit.png")" />
                </div>
                <span asp-validation-for="Client.ClientEmail" class="errorData"></span>
            </li>
            @if (!isClient)
            {
                <li class="field">
                    <div class="input-wrapper">
                        <input asp-for="Client.Password" id="password" type="password" placeholder="Password" value="@Model.Client?.Password" />
                        <img class="icon" src="~/images/lock.png"/>
                    </div>
                    <span asp-validation-for="Client.Password" class="errorData" ></span>
                </li>
            }
            else
            {
                <li class="field">
                    <div class="input-wrapper">
                        <input asp-for="Client.Password" id="password" type="hidden" placeholder="Password" />
                    </div>
                </li>
            }
        </ul>
        <button class="buttonReset" type="reset">Reset</button>
        <button class="buttonSignUp" type="submit">@(!isClient ? "Sign Up" : "Save Changes")</button>
        @if (!isClient)
        {
            <div class="Login-link">
                <p>Already have an account? <a href="http://localhost:5290/Client/ViewLogin/">Login</a></p>
            </div>
        }
    </form>
</div>

