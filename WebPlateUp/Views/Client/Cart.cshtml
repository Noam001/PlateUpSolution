@using Models;
@model CartViewModel
@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/MasterPage.cshtml";
}
<link href="~/stylesheet/cart.css" rel="stylesheet" />
<div class="cart-page">
    <h1>My Shopping Cart</h1>

    @if (Model?.CartItems != null && Model.CartItems.Count > 0)
    {
        <div class="cart-layout">
            @* צד שמאל - רשימת המנות *@
            <div class="cart-items-section">
                @foreach (var item in Model.CartItems)
                {
                    <div class="cart-item-card">
                        <div class="meal-link-wrapper">
                            <a href="http://localhost:5290/Guest/MealDetails/?id=@item.MealId" class="meal-link">
                                <div class="item-image">
                                    <img src="http://localhost:5035/DataImages/@item.MealPhoto" alt="@item.MealName" />
                                </div>
                                <div class="item-name">
                                    <h3>@item.MealName</h3>
                                    <p class="item-price">$@item.MealPrice</p>
                                </div>
                            </a>

                            <form asp-controller="Client" asp-action="UpdateNote" method="get" class="note-form">
                                <input type="hidden" name="mealId" value="@item.MealId" />
                                <input type="hidden" name="orderId" value="@item.OrderID" />
                                @if (!string.IsNullOrEmpty(item.MealNotes))
                                {
                                    <input type="text" name="note" value="@item.MealNotes" class="note-input" />
                                }
                                else
                                {
                                    <input type="text" name="note" value="" placeholder="Add a note..." class="note-input" />
                                }
                                <button type="submit" class="note-btn">✓</button>
                            </form>
                        </div>

                        <div class="item-controls">
                            @* שינוי כמות *@
                            <form asp-controller="Client" asp-action="UpdateQuantity" method="get" class="quantity-form">
                                <input type="hidden" name="mealId" value="@item.MealId" />
                                <input type="hidden" name="orderId" value="@item.OrderID" />
                                <select name="quantity" class="quantity-select" onchange="this.form.submit()">
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        <option value="@i" selected="@(i == item.Quantity)">@i</option>
                                    }
                                </select>
                            </form>

                            @* כפתור מחיקה *@
                            <form asp-controller="Client" asp-action="RemoveMealFromOrder" method="get" class="delete-form">
                                <input type="hidden" name="mealId" value="@item.MealId" />
                                <input type="hidden" name="orderId" value="@item.OrderID" />
                                <button type="submit" class="delete-btn" title="Remove">🗑️</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            @* צד ימין - סיכום *@
            <div class="cart-summary">
                <h2>Order Summary</h2>

                <div class="summary-details">
                    <div class="summary-row">
                        <span>Total Meals:</span>
                        <span class="total-meals">@Model.TotalItems</span>
                    </div>

                    <div class="summary-row total-price">
                        <span>Total Price:</span>
                        <span class="price">$@Model.TotalPrice.ToString("F2")</span>
                    </div>
                </div>

                <a href="http://localhost:5290/Client/CheckoutView/?orderId=@Model.CartItems[0].OrderID&totalPrice=@Model.TotalPrice.ToString("F2")" class="checkout-btn">Checkout</a>

                <a href="http://localhost:5290/Guest/Menu/" class="continue-shopping">← Continue Shopping</a>
            </div>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <div class="empty-icon">🛒</div>
            <h2>Your cart is empty</h2>
            <p>Add some delicious meals to get started!</p>
            <a href="http://localhost:5290/Guest/Menu/" class="browse-menu-btn">Browse Menu</a>
        </div>
    }
</div>

